# Copy to .env for LOCAL testing only. In the cloud these are injected from Secret Manager.

# --- Gmail (required) ---
# Create an App Password at: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=godavartivinaykumar@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Where to send the finished clip (defaults to GMAIL_ADDRESS if omitted)
RECIPIENT=godavartivinaykumar@gmail.com

# --- LLM: Gemini on Vertex AI ---
GOOGLE_CLOUD_PROJECT=dailynews-507123
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REGION=us-central1

# --- Curation strategy: deterministic (default) or agentic (Google ADK) ---
CURATOR=deterministic

# --- Text-to-Speech ---
# Default is a stable Chirp3-HD voice. To try Gemini TTS instead, set TTS_MODEL to a
# gemini-*-tts model and TTS_VOICE to a short name like "Charon" (needs texttospeech >= 2.29.0).
TTS_LANGUAGE=en-US
TTS_VOICE=en-US-Chirp3-HD-Charon
TTS_MODEL=
TTS_PROMPT=Read this in a warm, natural, upbeat morning-briefing tone.

# --- Optional archive (also backs the agentic curator's memory) ---
GCS_BUCKET=

# --- Tracing: OpenTelemetry -> Cloud Trace (no LangSmith/LangChain needed) ---
# ADK emits the GenAI spans; observability.py points them at telemetry.googleapis.com.
# One-time project setup:
#   gcloud services enable telemetry.googleapis.com cloudtrace.googleapis.com monitoring.googleapis.com
TRACE_ENABLED=1
# Cloud Monitoring metric export. Off by default: token counts are already on the spans, and this
# exporter fails intermittently and logs a full traceback when it does.
TRACE_METRICS=0
# cloudtrace = classic cloudtrace.googleapis.com (default, queryable immediately)
# telemetry  = OTLP to telemetry.googleapis.com; only once the project has a trace bucket,
#              otherwise spans are accepted and silently unreadable
TRACE_BACKEND=cloudtrace
# OTel log export (Cloud Run already captures stdout, so this is opt-in)
TRACE_LOGS=0
# Prompt/response text on spans. Defaults on locally, off in Cloud Run (K_SERVICE is set there).
# TRACE_CONTENT=1
# Service name traces are grouped under in Trace Explorer
OTEL_SERVICE_NAME=daily-news

# --- Evals: judge model for the ADK metrics (kept off the generator's model family) ---
EVAL_JUDGE_MODEL=gemini-2.5-flash
# How many times each ADK evaluator samples the judge and votes (ADK's own default is 5, which is
# 40 judge calls for a 4-segment digest and enough to get OOM-killed on a laptop).
EVAL_JUDGE_SAMPLES=3

# --- Dev: print the script and skip audio + email ---
# DRY_RUN=1

# --- Optional: Product Hunt source (disabled unless set) ---
# PRODUCTHUNT_TOKEN=

# --- Realtime interactive agent (phone-call mode; all optional) ---
REALTIME_PROVIDER=elevenlabs
# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Retell (alternate provider, later)
# RETELL_API_KEY=
# RETELL_AGENT_ID=
# Telephony (Twilio) + who the agent calls each morning
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
USER_PHONE_NUMBER=

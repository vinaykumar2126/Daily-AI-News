# Copy to .env for LOCAL testing only. In the cloud these are injected from Secret Manager.

# --- Gmail (required) ---
# Create an App Password at: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=godavartivinaykumar@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Where to send the finished clip (defaults to GMAIL_ADDRESS if omitted)
RECIPIENT=godavartivinaykumar@gmail.com

# --- Source newsletter matching ---
TLDR_SENDER=dan@tldrnewsletter.com
TLDR_SUBJECT_CONTAINS=TLDR AI
IMAP_LOOKBACK_DAYS=3

# --- LLM: Vertex AI (default) ---
USE_VERTEX=1
GOOGLE_CLOUD_PROJECT=dailynews-507123
VERTEX_REGION=us-east5
VERTEX_MODEL=claude-haiku-4-5@20251001

# --- LLM: Anthropic API fallback (optional) ---
# Used automatically if the Vertex call fails and a key is present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Text-to-Speech ---
TTS_LANGUAGE=en-US
TTS_VOICE=en-US-Neural2-D

# --- Optional archive ---
GCS_BUCKET=
